<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE"/>
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Saving the payment QR code to the gallery (gal). Only Android 9 and
         older need a permission for that; newer versions write to Pictures
         without one. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <application
        android:label="Arc Platform"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowAudioPlaybackCapture="false"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- Push notifications: white Arc mark in the status bar, brand
             orange, and the high-importance channel the app creates. -->
        <!-- Android 16 ignores screen-rotation requests on tablets for apps
             targeting API 36. This asks to keep honoring them (a temporary
             opt-out, removed when targeting API 37). The video player also
             turns itself when the system doesn't rotate. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_arc" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/arc_orange" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="arc_default" />
        <!-- FLAG_SECURE (set at runtime in MainActivity/ScreenSecurity while a
             lecture is playing) only blocks the VIDEO half of a screen
             recording; Android's AudioPlaybackCapture API (used by most
             screen recorders since Android 10) captures this app's audio
             output independently of that flag. This attribute opts the whole
             app out of that API, so a screen recording of a lecture comes out
             silent instead of video-blocked-but-audio-intact. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Auth links are handled by supabase_flutter (app_links). With
                 Flutter's own deep linking on, a link arriving while the app
                 is open is ALSO pushed as a named route, which doesn't exist
                 and throws. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Google sign-in callback: the browser hands the finished OAuth
                 session back to the app via this scheme
                 (SupabaseService.kGoogleRedirectUrl), which supabase_flutter
                 picks up and turns into an AuthChangeEvent.signedIn. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="siteandstructure" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Package visibility for url_launcher on Android 11+ (API 30).
             Without these, canLaunchUrl() returns false for apps that are in
             fact installed, because the platform hides them from us. Used by
             the profile social row (Instagram / Telegram / WhatsApp / call)
             and the support contact links. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="instagram"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tg"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
